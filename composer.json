{
    "name": "essa/api_tool_kit",
    "description": "set of tools to build an api with laravel",
    "keywords": [
        "laravel",
        "api",
        "filters",
        "dynamic-pagination",
        "tools",
        "api-generator"
    ],
    "homepage": "https://github.com/ahmedesa/laravel-api-tool-kit",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed Esa",
            "email": "ahmedesa6120@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "laravel/framework": "^12.0||^13.0",
        "guzzlehttp/guzzle": "^7.16.1||^8.3.1"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^3.13.2",
        "orchestra/testbench": "^10.12||^11.3",
        "phpunit/phpunit": "^11.5.50||^12.5||^13.4.3",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Essa\\APIToolKit\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Essa\\APIToolKit\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Essa\\APIToolKit\\APIToolKitServiceProvider",
                "Essa\\APIToolKit\\MacroServiceProvider"
            ]
        }
    },
    "scripts": {
        "fix-style": "vendor/bin/pint",
        "check-code": [
            "vendor/bin/pint --test",
            "@analyse"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "suggest": {
        "fakerphp/faker": "Required in the host development environment to execute generated factories and seeders."
    }
}
